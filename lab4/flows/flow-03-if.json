      "parameters": {
        "jsCode": "// Массив с данными о книгах\nconst books = [\n  { title: \"Мастер и Маргарита\", author: \"Булгаков\", year: 1967 },\n  { title: \"Маленький принц\", author: \"Сент-Экзюпери\", year: 1943 },\n  { title: \"Гордость и предубеждение\", author: \"Остин\", year: 1813 }\n];\n\n// Считаем средний год\nlet totalYears = 0;\nfor (let i = 0; i < books.length; i++) {\n  totalYears += books[i].year;\n}\nconst averageYear = Math.round(totalYears / books.length);\n\n// Объект-результат\nconst result = {\n  student: \"Subotkovskaya\",\n  topic: \"lab4/Subotkovskaya/if\",\n  averageYear: averageYear,\n  isModern: false\n};\n\n// if/else — проверяем, современная ли литература в среднем\nif (averageYear > 1950) {\n  result.isModern = true;\n} else {\n  result.isModern = false;\n}\n\n// Возвращаем объект с полем payload\nreturn [{ json: { payload: result } }];"
      },
