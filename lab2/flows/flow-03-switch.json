    {
        "id": "51dc24a8a517ba1e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "// Получаем входные данные из msg.payload\nconst input = msg.payload;\n\n// Массив с пороговыми значениями для проверки\nconst thresholds = [10, 25, 50, 75, 100];\n\n// Объект для сбора результатов обработки\nlet result = {\n    input: input,\n    checks: [],\n    passed: 0,\n    failed: 0\n};\n\n// Проверяем, что входные данные — число\nif (typeof input !== \"number\") {\n    // Если не число, возвращаем сообщение об ошибке\n    msg.payload = { error: \"Ожидалось число\", received: input };\n    return msg;\n}\n\n// Проходим циклом по всем пороговым значениям\nfor (let i = 0; i < thresholds.length; i++) {\n    const threshold = thresholds[i];\n    // Сравниваем входное число с текущим порогом\n    if (input >= threshold) {\n        result.checks.push(\"Порог \" + threshold + \": пройден\");\n        result.passed++;\n    } else {\n        result.checks.push(\"Порог \" + threshold + \": не пройден\");\n        result.failed++;\n    }\n}\n\n// Формируем итоговый payload с объектом результата\nmsg.payload = result;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
