        "id": "7daa9ab9bf653024",
        "type": "function",
        "z": "4fc2ac267090840a",
        "name": "function ",
        "func": "// Получаем текущее значение счётчика из flow context\n// Если счётчика ещё нет — начинаем с 0\nlet counter = flow.get(\"counter\") || 0;\n\n// Увеличиваем счётчик на 1\ncounter = counter + 1;\n\n// Сохраняем обратно в flow context\nflow.set(\"counter\", counter);\n\n// Формируем сообщение с текущим значением\nmsg.payload = {\n    counter: counter,\n    message: \"Счётчик увеличен до \" + counter,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
